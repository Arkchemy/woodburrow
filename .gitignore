# Local Vercel CLI state and dependency/build output. Nothing in this
# repo is built ahead of deployment -- public/ is served as-is and api/
# is bundled by Vercel -- so anything below only ever appears from
# running the CLI or npm locally.
.vercel/
node_modules/
.env
.env.*
!.env.example

# The extracted voice lines are kept as an archive, the way the Skylanders
# wiki hosts catchphrase audio for documentation. Provenance and the
# extraction method are recorded in branding/voicelines/FINDINGS.md.

# Working intermediates, not deliverables
branding/icon/out/
branding/icon/out-tight/
